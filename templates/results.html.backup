<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>نتائج البحث - وين نلقى باتنة؟</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Cairo", sans-serif;
            background: #f5f5f5;
            color: #111;
        }

        /* =========================
           HEADER
        ========================= */

        header {
            background:
                linear-gradient(
                    135deg,
                    #050505,
                    #111111,
                    #1c1c1c
                );

            color: white;
            padding: 22px 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.18);
        }

        .header-content {
            max-width: 1200px;
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;
        }

        .logo {
            color: white;
            text-decoration: none;
            font-size: 25px;
            font-weight: 900;
        }

        .logo span {
            color: #d4af37;
        }

        .back-button {
            text-decoration: none;
            color: white;

            padding: 10px 18px;

            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 12px;

            background: rgba(255,255,255,0.08);

            font-weight: 600;

            transition: 0.2s;
        }

        .back-button:hover {
            background: rgba(255,255,255,0.16);
        }

        /* =========================
           SEARCH
        ========================= */

        .search-area {
            max-width: 1000px;
            margin: 35px auto 20px;
            padding: 0 20px;
        }

        .search-box {
            background: white;

            border-radius: 18px;

            padding: 8px;

            display: flex;
            gap: 8px;

            box-shadow:
                0 8px 30px rgba(0,0,0,0.08);
        }

        .search-box input {
            flex: 1;

            border: none;
            outline: none;

            padding: 14px 18px;

            font-family: "Cairo", sans-serif;
            font-size: 16px;

            background: transparent;
        }

        .search-button {
            border: none;

            background: #111;
            color: white;

            padding: 12px 25px;

            border-radius: 13px;

            font-family: "Cairo", sans-serif;
            font-weight: 700;

            cursor: pointer;

            transition: 0.2s;
        }

        .search-button:hover {
            background: #000;
            transform: translateY(-1px);
        }

        /* =========================
           TITLE
        ========================= */

        .page-title {
            max-width: 1200px;
            margin: 30px auto;

            padding: 0 20px;
        }

        .page-title h1 {
            margin: 0;

            font-size: 30px;
            font-weight: 900;
        }

        .page-title p {
            margin-top: 8px;

            color: #777;
            font-size: 15px;
        }

        /* =========================
           RESULTS
        ========================= */

        .results {
            max-width: 1200px;
            margin: auto;

            padding: 0 20px 50px;

            display: grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(280px, 1fr)
                );

            gap: 22px;
        }

        .place-card {
            background: white;

            border-radius: 20px;

            overflow: hidden;

            box-shadow:
                0 8px 30px rgba(0,0,0,0.07);

            transition:
                transform 0.25s,
                box-shadow 0.25s;

            border: 1px solid #eeeeee;
        }

        .place-card:hover {
            transform: translateY(-5px);

            box-shadow:
                0 15px 40px rgba(0,0,0,0.12);
        }

        /* =========================
           IMAGE
        ========================= */

        .place-image {
            width: 100%;
            height: 210px;

            object-fit: cover;

            display: block;
        }

        .no-image {
            height: 210px;

            display: flex;
            align-items: center;
            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    #111,
                    #292929
                );

            color: white;

            font-size: 50px;
        }

        /* =========================
           CARD CONTENT
        ========================= */

        .card-content {
            padding: 20px;
        }

        .category {
            display: inline-block;

            background: #f1f1f1;
            color: #333;

            padding: 5px 12px;

            border-radius: 20px;

            font-size: 12px;
            font-weight: 700;

            margin-bottom: 10px;
        }

        .place-name {
            margin: 0 0 10px;

            font-size: 21px;
            font-weight: 900;

            color: #111;
        }

        .info {
            color: #666;

            font-size: 14px;

            margin: 7px 0;

            line-height: 1.8;
        }

        .info strong {
            color: #222;
        }

        /* =========================
           BUTTON
        ========================= */

        .details-button {
            display: block;

            margin-top: 18px;

            text-align: center;

            text-decoration: none;

            background: #111;
            color: white;

            padding: 11px;

            border-radius: 12px;

            font-weight: 700;

            transition: 0.2s;
        }

        .details-button:hover {
            background: #000;
            transform: translateY(-1px);
        }

        /* =========================
           EMPTY
        ========================= */

        .empty {
            max-width: 700px;

            margin: 60px auto;

            background: white;

            border-radius: 20px;

            padding: 50px 25px;

            text-align: center;

            box-shadow:
                0 8px 30px rgba(0,0,0,0.07);
        }

        .empty-icon {
            font-size: 55px;
            margin-bottom: 15px;
        }

        .empty h2 {
            margin: 0 0 10px;

            font-size: 24px;
        }

        .empty p {
            color: #777;
            margin-bottom: 25px;
        }

        .home-button {
            display: inline-block;

            background: #111;
            color: white;

            text-decoration: none;

            padding: 12px 25px;

            border-radius: 12px;

            font-weight: 700;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            background: #080808;

            color: #aaa;

            text-align: center;

            padding: 25px 15px;

            font-size: 13px;
        }

        footer strong {
            color: white;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 600px) {

            .header-content {
                flex-direction: column;
            }

            .logo {
                font-size: 21px;
            }

            .search-box {
                flex-direction: column;
                background: white;
            }

            .search-button {
                width: 100%;
            }

            .page-title h1 {
                font-size: 24px;
            }

            .results {
                grid-template-columns: 1fr;
            }

        }

    
.place-rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 10px;
    min-height: 24px;
}

.rating-stars {
    color: #f59e0b;
    font-size: 17px;
    letter-spacing: 1px;
    line-height: 1;
}

.rating-value {
    color: #111827;
    font-size: 13px;
    font-weight: 800;
}

.rating-count {
    color: #64748b;
    font-size: 12px;
}

.no-rating {
    color: #94a3b8;
    font-size: 12px;
}

</style>
</head>

<body>

    <!-- HEADER -->

    <header>

        <div class="header-content">

            <a href="/" class="logo">
                وين نلقى <span>باتنة؟</span>
            </a>

            <a href="/" class="back-button">
                الرئيسية
            </a>

        </div>

    </header>


    <!-- SEARCH -->

    <section class="search-area">

        <form
            action="/search"
            method="GET"
            class="search-box"
        >

            <input
                type="text"
                name="q"
                value="{{ query }}"
                placeholder="ابحث عن محل، خدمة، مكان..."
                autocomplete="off"
            >

            <button
                type="submit"
                class="search-button"
            >
                بحث
            </button>

        </form>

    </section>


    <!-- TITLE -->

    <section class="page-title">

        {% if query %}

            <h1>
                نتائج البحث عن:
                "{{ query }}"
            </h1>

            <p>
                الأماكن والخدمات المطابقة لبحثك
            </p>

        {% else %}

            <h1>
                نتائج البحث
            </h1>

        {% endif %}

    </section>


    <!-- RESULTS -->

    {% if places %}

        <section class="results">

            {% for place in places %}

                <article class="place-card">

                    {% if place.image %}

                        <img
                            src="{{ url_for('static', filename='uploads/' + place.image) }}"
                            class="place-image"
                            alt="{{ place.name }}"
                        >

                    {% else %}

                        <div class="no-image">
                            📍
                        </div>

                    {% endif %}


                    <div class="card-content">

                        <span class="category">
                            {{ place.category }}
                        </span>

                        {% if place.review_count > 0 %}
                            <div class="place-rating">
                                <span class="rating-stars">
                                    {% for i in range(1, 6) %}
                                        {% if place.average_rating >= i %}
                                            ★
                                        {% else %}
                                            ☆
                                        {% endif %}
                                    {% endfor %}
                                </span>

                                <span class="rating-value">
                                    {{ place.average_rating }}/5
                                </span>

                                <span class="rating-count">
                                    ({{ place.review_count }} تقييم)
                                </span>
                            </div>
                        {% else %}
                            <div class="place-rating no-rating">
                                لا توجد تقييمات
                            </div>
                        {% endif %}

                        <h2 class="place-name">
                            {{ place.name }}
                        </h2>


                        {% if place.address %}

                            <div class="info">
                                <strong>العنوان:</strong>
                                {{ place.address }}
                            </div>

                        {% endif %}


                        {% if place.phone %}

                            <div class="info">
                                <strong>الهاتف:</strong>
                                {{ place.phone }}
                            </div>

                        {% endif %}


                        {% if place.description %}

                            <div class="info">
                                {{ place.description[:120] }}

                                {% if place.description|length > 120 %}
                                    ...
                                {% endif %}
                            </div>

                        {% endif %}


                        <a
                            href="{{ url_for('place', place_id=place.id) }}"
                            class="details-button"
                        >
                            مشاهدة التفاصيل
                        </a>

                    </div>

                </article>

            {% endfor %}

        </section>

    {% else %}

        <div class="empty">

            <div class="empty-icon">
                🔍
            </div>

            <h2>
                لم نجد نتائج
            </h2>

            <p>
                لم يتم العثور على مكان يطابق البحث.
            </p>

            <a
                href="/"
                class="home-button"
            >
                العودة إلى الرئيسية
            </a>

        </div>

    {% endif %}


    <!-- FOOTER -->

    <footer>

        <strong>
            وين نلقى باتنة؟
        </strong>

        <br>

        دليل الأماكن والخدمات في مدينة باتنة

    </footer>

</body>

</html>
