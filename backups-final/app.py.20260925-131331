@app.route("/place/<int:place_id>")
def place(place_id):

    conn = get_db()

    # بيانات المكان
    place_data = conn.execute("""
        SELECT *
        FROM places
        WHERE id = ?
    """, (
        place_id,
    )).fetchone()

    if place_data is None:

        conn.close()

        return "المحل غير موجود", 404

    # التقييمات
    reviews = conn.execute("""
        SELECT *
        FROM reviews
        WHERE place_id = ?
        ORDER BY id DESC
    """, (
        place_id,
    )).fetchall()

    # متوسط التقييم
    average_result = conn.execute("""
        SELECT AVG(rating)
        FROM reviews
        WHERE place_id = ?
    """, (
        place_id,
    )).fetchone()

    if (
        average_result
        and average_result[0] is not None
    ):
        average = round(
            average_result[0],
            1
        )
    else:
        average = 0

    conn.close()

    return render_template(
        "place.html",
        place=place_data,
        reviews=reviews,
        average=average
    )


