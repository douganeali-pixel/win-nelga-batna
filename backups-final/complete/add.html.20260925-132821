<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>إضافة مكان - وين نلقى باتنة؟</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Cairo", sans-serif;
            background: #f5f5f5;
            color: #111;
        }

        header {
            background: linear-gradient(
                135deg,
                #050505,
                #111111,
                #1c1c1c
            );

            color: white;
            padding: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.18);
        }

        .header-content {
            max-width: 1100px;
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 15px;
        }

        .logo {
            color: white;
            text-decoration: none;

            font-size: 25px;
            font-weight: 900;
        }

        .logo span {
            color: #d4af37;
        }

        .back-button {
            color: white;
            text-decoration: none;

            padding: 9px 18px;

            border-radius: 12px;

            background: rgba(255,255,255,0.08);

            border: 1px solid rgba(255,255,255,0.18);
        }

        .container {
            max-width: 900px;
            margin: 35px auto;
            padding: 0 20px 50px;
        }

        .title {
            margin-bottom: 25px;
        }

        .title h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 900;
        }

        .title p {
            color: #777;
            margin-top: 7px;
        }

        .card {
            background: white;
            border-radius: 22px;
            padding: 28px;

            box-shadow:
                0 10px 35px rgba(0,0,0,0.08);

            border: 1px solid #eee;
        }

        .field {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;

            font-size: 14px;
            font-weight: 800;
        }

        input,
        select,
        textarea {
            width: 100%;

            border: 1px solid #ddd;
            border-radius: 12px;

            padding: 13px 15px;

            font-family: "Cairo", sans-serif;
            font-size: 14px;

            outline: none;

            background: #fff;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #111;
            box-shadow: 0 0 0 3px rgba(0,0,0,0.05);
        }

        textarea {
            min-height: 130px;
            resize: vertical;
        }

        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .upload-box {
            border: 2px dashed #ccc;
            border-radius: 15px;

            padding: 25px;

            text-align: center;

            background: #fafafa;
        }

        .upload-box input {
            border: none;
            padding: 10px;
        }

        .map-title {
            margin-top: 30px;
            margin-bottom: 10px;

            font-size: 18px;
            font-weight: 900;
        }

        .map-help {
            color: #777;
            font-size: 13px;
            margin-bottom: 12px;
        }

        #map {
            width: 100%;
            height: 380px;

            border-radius: 18px;
            overflow: hidden;

            border: 1px solid #ddd;
        }

        .coordinates {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;

            margin-top: 15px;
        }

        .coordinates input {
            background: #f5f5f5;
        }

        .submit-button {
            width: 100%;

            margin-top: 25px;

            border: none;
            border-radius: 13px;

            padding: 15px;

            background: #111;
            color: white;

            font-family: "Cairo", sans-serif;
            font-size: 16px;
            font-weight: 800;

            cursor: pointer;

            transition: 0.2s;
        }

        .submit-button:hover {
            background: #000;
            transform: translateY(-1px);
        }

        footer {
            background: #080808;
            color: #999;

            text-align: center;
            padding: 25px 15px;

            font-size: 13px;
        }

        footer strong {
            color: white;
        }

        @media (max-width: 650px) {

            .header-content {
                flex-direction: column;
            }

            .row,
            .coordinates {
                grid-template-columns: 1fr;
            }

            .card {
                padding: 20px;
            }

            .title h1 {
                font-size: 25px;
            }

        }

    </style>
</head>

<body>

<header>

    <div class="header-content">

        <a href="/" class="logo">
            وين نلقى <span>باتنة؟</span>
        </a>

        <a href="/" class="back-button">
            الرئيسية
        </a>

    </div>

</header>


<div class="container">

    <div class="title">

        <h1>
            إضافة مكان جديد
        </h1>

        <p>
            أضف معلومات المكان ليسهل على سكان باتنة الوصول إليه.
        </p>

    </div>


    <div class="card">

        <form
            method="POST"
            enctype="multipart/form-data"
        >

            <div class="row">

                <div class="field">

                    <label>
                        اسم المكان
                    </label>

                    <input
                        type="text"
                        name="name"
                        placeholder="مثال: مخبزة النجاح"
                        required
                    >

                </div>


                <div class="field">

                    <label>
                        التصنيف
                    </label>

                    <select name="category" required>

                        <option value="">
                            اختر التصنيف
                        </option>

                        <option value="مطعم">
                            مطعم
                        </option>

                        <option value="حلويات">
                            حلويات
                        </option>

                        <option value="مخبزة">
                            مخبزة
                        </option>

                        <option value="ملابس">
                            ملابس
                        </option>

                        <option value="إلكترونيات">
                            إلكترونيات
                        </option>

                        <option value="قطع غيار">
                            قطع غيار
                        </option>

                        <option value="خدمات">
                            خدمات
                        </option>

                        <option value="طبيب">
                            طبيب
                        </option>

                        <option value="صيدلية">
                            صيدلية
                        </option>

                        <option value="أخرى">
                            أخرى
                        </option>

                    </select>

                </div>

            </div>


            <div class="field">

                <label>
                    العنوان
                </label>

                <input
                    type="text"
                    name="address"
                    placeholder="مثال: بوعقال 03، باتنة"
                    required
                >

            </div>


            <div class="row">

                <div class="field">

                    <label>
                        رقم الهاتف
                    </label>

                    <input
                        type="text"
                        name="phone"
                        placeholder="مثال: 0550 00 00 00"
                    >

                </div>


                <div class="field">

                    <label>
                        اسم المسؤول أو صاحب المكان
                    </label>

                    <input
                        type="text"
                        name="owner"
                        placeholder="اختياري"
                    >

                </div>

            </div>


            <div class="field">

                <label>
                    وصف المكان
                </label>

                
<div class="form-group">
    <label for="opening_time">وقت الفتح</label>
    <input type="time" id="opening_time" name="opening_time"
           value="{{ place.opening_time if place is defined and place.opening_time else '08:00' }}">
</div>

<div class="form-group">
    <label for="closing_time">وقت الإغلاق</label>
    <input type="time" id="closing_time" name="closing_time"
           value="{{ place.closing_time if place is defined and place.closing_time else '18:00' }}">
</div>

<div class="form-group">
    <label for="working_days">أيام العمل</label>
    <input type="text" id="working_days" name="working_days"
           value="{{ place.working_days if place is defined and place.working_days else '1,2,3,4,5,6' }}"
           placeholder="1,2,3,4,5,6">
    <small>1=الإثنين، 2=الثلاثاء ... 7=الأحد</small>
</div>

<textarea
                    name="description"
                    placeholder="اكتب معلومات مفيدة عن المكان والخدمات التي يقدمها..."
                ></textarea>

            </div>


            <div class="field">

                <label>
                    صورة المكان
                </label>

                <div class="upload-box">

                    <input
                        type="file"
                        name="image"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                    <div>
                        اختر صورة واضحة للمكان
                    </div>

                </div>

            </div>


            <div class="map-title">
                موقع المكان على الخريطة
            </div>

            <div class="map-help">
                اضغط على الخريطة لتحديد موقع المكان بدقة.
            </div>

            <div id="map"></div>


            <div class="coordinates">

                <div>

                    <label>
                        خط العرض
                    </label>

                    <input
                        type="text"
                        id="latitude"
                        name="latitude"
                        readonly
                    >

                </div>


                <div>

                    <label>
                        خط الطول
                    </label>

                    <input
                        type="text"
                        id="longitude"
                        name="longitude"
                        readonly
                    >

                </div>

            </div>


            <button
                type="submit"
                class="submit-button"
            >
                حفظ المكان
            </button>

        </form>

    </div>

</div>


<footer>

    <strong>
        وين نلقى باتنة؟
    </strong>

    <br>

    دليل الأماكن والخدمات في مدينة باتنة

</footer>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

    const map = L.map("map").setView(
        [35.5559, 6.1741],
        13
    );


    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution: "&copy; OpenStreetMap"
        }
    ).addTo(map);


    let marker = null;


    map.on("click", function(e) {

        const lat = e.latlng.lat.toFixed(6);
        const lng = e.latlng.lng.toFixed(6);


        document.getElementById(
            "latitude"
        ).value = lat;


        document.getElementById(
            "longitude"
        ).value = lng;


        if (marker) {
            map.removeLayer(marker);
        }


        marker = L.marker([
            e.latlng.lat,
            e.latlng.lng
        ]).addTo(map);


        marker.bindPopup(
            "موقع المكان المحدد"
        ).openPopup();

    });

</script>

</body>

</html>
